FROM php:8.2-fpm

# Install dependencies
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev libpng-dev libonig-dev libxml2-dev libicu-dev curl \
    && docker-php-ext-install pdo pdo_mysql zip gd bcmath mbstring xml intl \
    && pecl install redis \
    && docker-php-ext-enable redis

# Workdir
WORKDIR /var/www/html

# Copy composer from official
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy source code
COPY . .

# Buat folder Laravel yang dibutuhkan
RUN mkdir -p bootstrap/cache storage/framework/{sessions,cache,views} storage/logs \
    && chmod -R 775 bootstrap/cache storage \
    && chown -R www-data:www-data bootstrap/cache storage

# Install dependencies (production only)
RUN composer install --no-dev --optimize-autoloader

# Expose port
EXPOSE 9008

# Copy PHP-FPM custom config
RUN rm /usr/local/etc/php-fpm.d/www.conf
COPY www.conf /usr/local/etc/php-fpm.d/www.conf

# Set upload limits
RUN echo "upload_max_filesize=50M" > /usr/local/etc/php/conf.d/99-upload.ini \
 && echo "memory_limit=1024M" >> /usr/local/etc/php/conf.d/99-upload.ini \
 && echo "post_max_size=50M" >> /usr/local/etc/php/conf.d/99-upload.ini

# Start php-fpm
CMD ["php-fpm", "-F", "-y", "/usr/local/etc/php-fpm.d/www.conf"]
